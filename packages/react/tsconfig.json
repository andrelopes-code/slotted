{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "types": ["vitest/globals", "@testing-library/jest-dom", "vite/client"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite.styles.config.ts",
    "vitest.config.ts",
    "vitest.perf.config.ts"
  ]
}
