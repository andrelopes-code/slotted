{
  "$schema": "https://json.schemastore.org/tsconfig",
  /**
   * The preset, and nothing else.
   *
   * Eight configs extend this file — `react`, `core`, `storybook-workbench`,
   * the Angular library and both Storybook apps, plus the two build configs —
   * and every one of them is a different program over a different set of files.
   * So this file may hold only what is true of all of them: how TypeScript
   * judges code. Anything that says *which* code, or *where its state lives*,
   * belongs to a project, and the whole-repository project is `tsconfig.json`
   * beside this one.
   *
   * The rule exists because breaking it cost a run of the typecheck in every
   * session for weeks. `tsBuildInfoFile` lived here, and a relative path in an
   * extended config resolves against the config that declared it — so all nine
   * programs wrote one incremental file at the repository root. A build left it
   * describing a package's program; the next root typecheck read it, reported
   * 814 circular errors across every `*.stories.tsx`, rewrote it, and passed on
   * the second run with no file changed (G6). `scripts/verify-typecheck-projects.test.mjs`
   * holds this file to options only so the next one cannot be added by hand.
   */
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@slotted/angular/*": ["./packages/angular/*/src/public-api.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "useUnknownInCatchVariables": true
  }
}
