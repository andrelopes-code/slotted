{
  "$schema": "https://json.schemastore.org/tsconfig",
  /**
   * The program `@analogjs/vite-plugin-angular` compiles: the Angular examples,
   * and through `paths` the `@slotted/angular` source they import. A file
   * outside this program reaches no Angular transform, so a `@Component` in it
   * is never compiled. Type-checking of the whole site stays with
   * `tsconfig.json` and `astro check`.
   */
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "resolveJsonModule": true,
    "target": "ES2022",
    "types": [],
    "paths": {
      "@slotted/angular/*": ["../../packages/angular/*/src/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictTemplates": true
  },
  "include": ["examples/angular/**/*.ts"]
}
