---
/* Generated by scripts/family-routes.mjs: one route per family, so the build hands
   this page only this family's stylesheets. */
import { getEntry } from 'astro:content';
import type { ComponentType } from 'react';

import FamilyPage from '../../../components/FamilyPage.astro';
import type { AngularExampleModule } from '../../../runtime/angular-component';
import { FRAMEWORKS, type Framework } from '../../../runtime/frameworks';

export function getStaticPaths() {
  return FRAMEWORKS.map((framework) => ({ params: { framework } }));
}

const entry = await getEntry('components', 'date-range-picker');
if (!entry) throw new Error('No components entry "date-range-picker"');
const examples = {
  react: import.meta.glob<{ default: ComponentType }>('../../../../examples/react/date-range-picker/*.tsx'),
  angular: import.meta.glob<AngularExampleModule>('../../../../examples/angular/date-range-picker/*.ts'),
};
---

<FamilyPage entry={entry} framework={Astro.params.framework as Framework} examples={examples} />

<script>
  import { startPreviews } from '../../../runtime/client';

  startPreviews({
    react: import.meta.glob('../../../../examples/react/date-range-picker/*.tsx'),
    angular: import.meta.glob('../../../../examples/angular/date-range-picker/*.ts'),
  });
</script>
