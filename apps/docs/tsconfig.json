{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "types": ["node", "astro/client"],
    "paths": {
      "@slotted/angular/*": ["../../packages/angular/*/src/public-api.ts"],
      "@slotted/core": ["../../packages/core/src/index.ts"],
      "@slotted/core/*": ["../../packages/core/src/*/index.ts"],
      "@slotted/react": ["../../packages/react/src/index.ts"],
      "@slotted/react/*": ["../../packages/react/src/*/index.ts"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "examples/**/*"],
  "exclude": ["dist", "node_modules"]
}
