{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "nexora-operations": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "inter-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/inter/files",
                "output": "fonts"
              },
              {
                "glob": "nunito-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/nunito/files",
                "output": "fonts"
              },
              {
                "glob": "source-sans-3-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/source-sans-3/files",
                "output": "fonts"
              },
              {
                "glob": "outfit-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/outfit/files",
                "output": "fonts"
              },
              {
                "glob": "source-serif-4-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/source-serif-4/files",
                "output": "fonts"
              },
              {
                "glob": "fraunces-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/fraunces/files",
                "output": "fonts"
              },
              {
                "glob": "jetbrains-mono-latin-wght-normal.woff2",
                "input": "node_modules/@fontsource-variable/jetbrains-mono/files",
                "output": "fonts"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3.75MB",
                  "maximumError": "4.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4250,
            "host": "0.0.0.0",
            "allowedHosts": ["devserver.local"],
            "prebundle": { "exclude": ["@slotted/demo-nexora-backend"] }
          },
          "configurations": {
            "production": {
              "buildTarget": "nexora-operations:build:production"
            },
            "development": {
              "buildTarget": "nexora-operations:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
