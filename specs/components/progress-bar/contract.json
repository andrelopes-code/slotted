{
  "schemaVersion": 4,
  "family": "progress-bar",
  "role": "progressbar",
  "min": 0,
  "stateAttributes": {
    "indeterminate": "data-indeterminate"
  },
  "members": {
    "progressBar": {
      "nativeElement": "div",
      "defaults": {
        "max": 100
      },
      "capabilities": ["measurement"],
      "states": ["default", "indeterminate"],
      "parts": ["root", "indicator"]
    }
  },
  "scenarios": {
    "progressBar": ["playground", "values", "indeterminate", "accessibility"]
  }
}
