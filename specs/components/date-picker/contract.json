{
  "schemaVersion": 5,
  "family": "date-picker",
  "ui": "date-picker",
  "catalog": {
    "group": "Forms",
    "summary": "Date field with a calendar popover."
  },
  "controlPart": "control",
  "rootRole": null,
  "contentRole": "dialog",
  "valueType": "PlainDate | null",
  "composes": ["date-field", "calendar", "picker-panel"],
  "core": [
    "@slotted/core/date",
    "@slotted/core/state",
    "@slotted/core/presence",
    "@slotted/core/portal",
    "@slotted/core/positioner",
    "@slotted/core/dismissable-layer",
    "@slotted/core/focus"
  ],
  "stateSource": "field",
  "mirrorsState": true,
  "wiring": {
    "aria-haspopup": "dialog",
    "aria-expanded": "the trigger, while the popup is showing",
    "aria-controls": "the content, while the popup is showing",
    "aria-label": "the trigger, carrying the selected date"
  },
  "triggerName": {
    "empty": "the choose message",
    "chosen": "the change message, with the whole date in words in its date slot",
    "why": "Focus returns to the trigger when the popup closes, so the name is where the reader is told what was chosen. The APG's own example names this as an accessibility feature."
  },
  "keyboard": [
    {
      "key": "Alt+ArrowDown",
      "effect": "open",
      "from": "the field"
    },
    {
      "key": "Escape",
      "effect": "close",
      "focusTo": "trigger",
      "staged": "the calendar takes it first while its view is month or year"
    },
    {
      "key": "Tab",
      "effect": "contained",
      "while": "open"
    }
  ],
  "platformNotes": {
    "altArrowDown": "ChromeOS turns Alt+ArrowDown into PageDown before the browser sees it, which Angular Material records for its own input. The trigger button is therefore the guaranteed path and the chord is a shortcut, never the only way in."
  },
  "dismissal": {
    "escape": "through dismissable-layer, in the capture phase",
    "outsidePress": true,
    "discards": "the draft"
  },
  "axes": {
    "size": ["sm", "md", "lg"],
    "variant": ["outline", "subtle", "plain"],
    "placement": ["bottom-start", "bottom", "bottom-end", "top-start", "top", "top-end"],
    "calendar": ["gregory"],
    "confirm": ["on", "off"]
  },
  "resolution": {
    "size": ["prop", "field", "defaults", "md"],
    "variant": ["prop", "defaults", "outline"],
    "placement": ["prop", "defaults", "bottom-start"],
    "locale": ["prop", "slotted", "en-US"],
    "timeZone": ["prop", "defaults", "runtime"],
    "calendar": ["prop", "defaults", "gregory"],
    "confirm": ["prop", "defaults", "off for one date or one month, on for a run or a set"]
  },
  "provides": {
    "datePickerDefaults": ["calendar", "confirm", "placement", "size", "timeZone", "variant"]
  },
  "messages": ["change", "choose", "refused"],
  "imperative": ["focus", "open", "close"],
  "stateAttributes": {
    "disabled": "data-disabled",
    "invalid": "data-invalid",
    "readonly": "data-readonly",
    "required": "data-required",
    "open": "data-open"
  },
  "dataAttributes": {
    "data-placement": "the side and alignment the positioner resolved",
    "data-presentation": "popover or sheet"
  },
  "stateModel": {
    "value": {
      "controlled": "value",
      "uncontrolled": "defaultValue",
      "request": "onValueChange",
      "reasons": ["pointer", "keyboard", "select", "clear", "programmatic"],
      "carries": ["value", "previous", "reason", "event"]
    },
    "open": {
      "controlled": "open",
      "uncontrolled": "defaultOpen",
      "request": "onOpenChange",
      "reasons": ["pointer", "keyboard", "escape", "outsidePress", "select"],
      "carries": ["value", "previous", "reason", "event"]
    }
  },
  "literals": {},
  "members": {
    "datePicker": {
      "nativeElement": "div",
      "defaults": {
        "size": "md",
        "variant": "outline",
        "placement": "bottom-start",
        "calendar": "gregory",
        "clearable": false
      },
      "capabilities": [
        "value",
        "open",
        "placement",
        "appearance",
        "size",
        "content",
        "disabled",
        "invalid",
        "required",
        "readOnly",
        "wiring"
      ],
      "states": [
        "default",
        "hover",
        "active",
        "focus-visible",
        "disabled",
        "invalid",
        "readonly",
        "required",
        "open"
      ],
      "parts": ["root", "control", "trigger"]
    }
  },
  "scenarios": {
    "datePicker": [
      "playground",
      "presets",
      "range-and-set",
      "month",
      "confirm",
      "range-bounds",
      "unavailable",
      "sizes",
      "variants",
      "placement",
      "states",
      "forms",
      "narrow",
      "composition",
      "keyboard"
    ]
  },
  "panel": {
    "shape": "a rail of shortcuts and the twelve months of the year beside one month; the month alone without shortcuts",
    "head": "the value in words, what it means beside today, and a step of one day either way for one date",
    "months": "one below 760px, whatever months asks for"
  },
  "draft": {
    "rule": "without confirm a press that finishes the value writes it and closes; with it a press writes a draft and Apply writes the value",
    "dayStep": "a step of the head writes and keeps the panel open, over the days the rules refuse"
  },
  "presets": {
    "prop": "presets",
    "type": "readonly { label, value | () => value }[]",
    "first": "Today, for one date",
    "result": "the date in words; a run as its two ends"
  }
}
