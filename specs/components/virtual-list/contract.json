{
  "schemaVersion": 4,
  "family": "virtual-list",
  "role": "list",
  "itemRole": "listitem",
  "canvasRole": "none",
  "axis": "block",
  "focusable": "root",
  "keys": [],
  "required": ["itemCount", "itemSize"],
  "setSemantics": ["aria-setsize", "aria-posinset"],
  "members": {
    "virtualList": {
      "nativeElement": "div",
      "defaults": {
        "overscan": 4
      },
      "capabilities": ["virtualization"],
      "states": ["default", "focus-visible"],
      "parts": ["root", "canvas"]
    },
    "virtualListItem": {
      "nativeElement": "div",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["item"]
    }
  },
  "scenarios": {
    "virtualList": ["playground", "scale", "accessibility", "composition"]
  }
}
