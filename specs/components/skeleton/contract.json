{
  "schemaVersion": 5,
  "family": "skeleton",
  "ui": "skeleton",
  "catalog": {
    "group": "Feedback",
    "summary": "Placeholder shapes while content loads."
  },
  "sizedShapes": ["circle", "square"],
  "axes": {
    "shape": ["text", "block", "circle", "square"],
    "size": ["xs", "sm", "md", "lg", "xl"],
    "animation": ["shimmer", "pulse", "none"],
    "live": ["polite", "off"]
  },
  "stateAttributes": {
    "loading": "data-loading"
  },
  "messages": ["label"],
  "members": {
    "skeleton": {
      "nativeElement": "span",
      "defaults": {
        "shape": "text",
        "size": "md",
        "animation": "shimmer",
        "loading": true,
        "lines": 3,
        "lastLineSize": "62%",
        "live": "polite",
        "delay": 0,
        "minDuration": 0
      },
      "capabilities": ["appearance", "shape", "size", "loading", "live"],
      "states": ["default", "loading"],
      "parts": ["root", "text", "line", "region", "announcement"]
    }
  },
  "scenarios": {
    "skeleton": [
      "playground",
      "shapes",
      "text",
      "sizes",
      "wrapping",
      "region",
      "timing",
      "animation",
      "composition",
      "content",
      "accessibility"
    ]
  }
}
