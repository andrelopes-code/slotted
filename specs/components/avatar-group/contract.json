{
  "schemaVersion": 5,
  "family": "avatar-group",
  "ui": "avatar-group",
  "catalog": {
    "group": "Data display",
    "summary": "Overlapping avatars with an overflow count."
  },
  "memberFamily": "avatar",
  "provides": {
    "avatarDefaults": ["size", "shape", "variant"]
  },
  "axes": {
    "layout": ["stack", "spread"],
    "size": ["xs", "sm", "md", "lg", "xl"],
    "shape": ["circle", "square"]
  },
  "members": {
    "avatarGroup": {
      "nativeElement": "ul",
      "defaults": {
        "layout": "stack",
        "size": "md",
        "shape": "circle",
        "max": 5
      },
      "capabilities": ["appearance", "size", "shape"],
      "states": ["default", "hover", "focus-visible"],
      "parts": ["root", "item", "overflow"]
    }
  },
  "scenarios": {
    "avatarGroup": [
      "playground",
      "layout",
      "overflow",
      "sizes",
      "composition",
      "extremes",
      "accessibility"
    ]
  }
}
