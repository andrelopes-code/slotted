{
  "schemaVersion": 4,
  "family": "stepper",
  "connector": "stylesheet",
  "orientations": ["horizontal", "vertical"],
  "axes": {
    "status": ["upcoming", "current", "complete"]
  },
  "members": {
    "stepper": {
      "nativeElement": "ol",
      "defaults": {
        "orientation": "horizontal"
      },
      "capabilities": ["orientation"],
      "states": ["default"],
      "parts": ["root"]
    },
    "stepperStep": {
      "nativeElement": "li",
      "defaults": {
        "status": "upcoming"
      },
      "capabilities": ["status"],
      "states": ["default"],
      "parts": ["step"]
    },
    "stepperMarker": {
      "nativeElement": "span",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["marker"]
    },
    "stepperLabel": {
      "nativeElement": "span",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["label"]
    }
  },
  "scenarios": {
    "stepper": ["playground", "status", "orientations", "composition"]
  }
}
