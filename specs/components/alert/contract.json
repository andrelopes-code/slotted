{
  "schemaVersion": 4,
  "family": "alert",
  "axes": {
    "variant": ["accent", "secondary", "success", "warning", "danger"],
    "fill": ["subtle", "outline", "solid"],
    "size": ["sm", "md"]
  },
  "liveness": ["off", "polite", "assertive"],
  "members": {
    "alert": {
      "nativeElement": "div",
      "defaults": {
        "variant": "accent",
        "fill": "subtle",
        "size": "md",
        "live": "off"
      },
      "capabilities": ["appearance", "live"],
      "states": ["default"],
      "parts": ["root"]
    },
    "alertIcon": {
      "nativeElement": "span",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["icon"]
    },
    "alertTitle": {
      "nativeElement": "div",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["title"]
    },
    "alertDescription": {
      "nativeElement": "p",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["description"]
    },
    "alertActions": {
      "nativeElement": "div",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["actions"]
    }
  },
  "scenarios": {
    "alert": ["playground", "appearance", "live", "composition"]
  }
}
