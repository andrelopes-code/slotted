{
  "schemaVersion": 5,
  "family": "field-group",
  "ui": "field-group",
  "catalog": {
    "group": "Forms",
    "summary": "Fieldset that groups related fields."
  },
  "role": null,
  "nativeDisabled": true,
  "messageFamily": "inline-message",
  "messageTones": {
    "description": "secondary",
    "error": "danger"
  },
  "messageMark": "none",
  "messagePlacement": "before",
  "identifiers": ["legend", "description", "error"],
  "describedBy": ["description", "error"],
  "describedByTarget": "root",
  "literals": {
    "--slotted-field-group-track-min": "14rem is a line length rather than a step on a scale: the width a field is given in a row before the row wraps, holding a date, a document number or a short name at the md step without the control clipping what is being typed into it."
  },
  "provides": {
    "fieldDefaults": ["size", "labelPlacement", "necessity", "disabled", "readOnly"]
  },
  "axes": {
    "kind": ["question", "section"],
    "size": ["sm", "md", "lg"],
    "orientation": ["vertical", "horizontal"],
    "necessity": ["mark", "optional", "words", "none"]
  },
  "stateAttributes": {
    "disabled": "data-disabled",
    "invalid": "data-invalid",
    "required": "data-required",
    "readonly": "data-readonly"
  },
  "members": {
    "fieldGroup": {
      "nativeElement": "fieldset",
      "defaults": {
        "kind": "question",
        "size": "md",
        "orientation": "vertical",
        "necessity": "mark"
      },
      "capabilities": [
        "appearance",
        "orientation",
        "size",
        "live",
        "disabled",
        "invalid",
        "required",
        "readOnly",
        "wiring"
      ],
      "states": ["default", "disabled", "invalid", "required", "readonly"],
      "parts": ["root", "legend", "mark", "content"]
    }
  },
  "scenarios": {
    "fieldGroup": [
      "playground",
      "orientation",
      "states",
      "messages",
      "provision",
      "content",
      "composition",
      "accessibility"
    ]
  }
}
