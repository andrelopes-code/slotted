{
  "schemaVersion": 4,
  "family": "switch",
  "role": "switch",
  "stateSource": "field",
  "mirrorsState": true,
  "requiredAttribute": "aria-required",
  "disabledAttribute": "disabled",
  "readOnly": "unsupported",
  "keys": ["Space", "Enter"],
  "keySource": "button",
  "axes": {
    "size": ["sm", "md", "lg"]
  },
  "stateAttributes": {
    "checked": "data-checked",
    "disabled": "data-disabled",
    "invalid": "data-invalid"
  },
  "members": {
    "switch": {
      "nativeElement": "button",
      "defaults": {
        "checked": false,
        "size": "md",
        "type": "button"
      },
      "capabilities": ["checked", "size", "disabled", "invalid", "required"],
      "states": ["default", "hover", "focus-visible", "checked", "disabled", "invalid"],
      "parts": ["root", "thumb"]
    }
  },
  "scenarios": {
    "switch": ["playground", "sizes", "states", "field"]
  }
}
