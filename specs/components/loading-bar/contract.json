{
  "schemaVersion": 4,
  "family": "loading-bar",
  "role": "progressbar",
  "min": 0,
  "axes": {
    "placement": ["inline", "fixed"]
  },
  "stateAttributes": {
    "indeterminate": "data-indeterminate"
  },
  "members": {
    "loadingBar": {
      "nativeElement": "div",
      "defaults": {
        "max": 100,
        "placement": "inline"
      },
      "capabilities": ["measurement", "placement"],
      "states": ["default", "indeterminate"],
      "parts": ["root", "indicator"]
    }
  },
  "scenarios": {
    "loadingBar": ["playground", "placement", "indeterminate", "accessibility"]
  }
}
