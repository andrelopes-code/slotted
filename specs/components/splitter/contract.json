{
  "schemaVersion": 4,
  "family": "splitter",
  "role": "separator",
  "panes": 2,
  "unit": "percent",
  "orientations": ["horizontal", "vertical"],
  "members": {
    "splitter": {
      "nativeElement": "div",
      "defaults": {
        "orientation": "horizontal",
        "max": 100,
        "min": 0,
        "step": 5
      },
      "capabilities": ["orientation", "measurement"],
      "states": ["default"],
      "parts": ["root"]
    },
    "splitterPane": {
      "nativeElement": "div",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["pane"]
    },
    "splitterHandle": {
      "nativeElement": "div",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default", "hover", "active", "focus-visible"],
      "parts": ["handle"]
    }
  },
  "scenarios": {
    "splitter": ["playground", "orientations", "keyboard", "composition"]
  }
}
