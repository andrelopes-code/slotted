{
  "schemaVersion": 5,
  "family": "status-indicator",
  "ui": "status-indicator",
  "catalog": {
    "group": "Data display",
    "summary": "Colored mark and label for a status."
  },
  "axes": {
    "status": ["neutral", "info", "success", "warning", "danger", "unknown"],
    "mark": ["dot", "icon"],
    "size": ["sm", "md", "lg"],
    "live": ["off", "polite", "assertive"]
  },
  "statusTones": {
    "neutral": "secondary",
    "info": "accent",
    "success": "success",
    "warning": "warning",
    "danger": "danger",
    "unknown": "secondary"
  },
  "statusGlyphs": {
    "neutral": "status-neutral",
    "info": "status-info",
    "success": "status-success",
    "warning": "status-warning",
    "danger": "status-failed",
    "unknown": "status-unknown"
  },
  "messages": ["danger", "info", "neutral", "success", "unknown", "warning"],
  "members": {
    "statusIndicator": {
      "nativeElement": "span",
      "defaults": {
        "status": "neutral",
        "mark": "dot",
        "size": "md",
        "live": "off",
        "pulse": false
      },
      "capabilities": ["appearance", "size", "status", "live"],
      "states": ["default", "focus-visible"],
      "parts": ["root", "mark", "label", "detail", "announcement"]
    }
  },
  "scenarios": {
    "statusIndicator": [
      "playground",
      "statuses",
      "marks",
      "sizes",
      "pulse",
      "announcements",
      "context",
      "content",
      "composition",
      "accessibility"
    ]
  }
}
