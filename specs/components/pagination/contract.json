{
  "schemaVersion": 4,
  "family": "pagination",
  "listReason": "siblings",
  "stateAttributes": {
    "current": "data-current",
    "disabled": "data-disabled"
  },
  "members": {
    "pagination": {
      "nativeElement": "nav",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["root"]
    },
    "paginationList": {
      "nativeElement": "ul",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["list"]
    },
    "paginationItem": {
      "nativeElement": "li",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["item"]
    },
    "paginationPage": {
      "nativeElement": "button",
      "defaults": {
        "current": false,
        "disabled": false
      },
      "capabilities": ["wiring", "current", "disabled"],
      "states": ["default", "hover", "active", "focus-visible", "current", "disabled"],
      "parts": ["page"]
    },
    "paginationEllipsis": {
      "nativeElement": "span",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["ellipsis"]
    }
  },
  "scenarios": {
    "pagination": ["playground", "current", "composition", "accessibility"]
  }
}
