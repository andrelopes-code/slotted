{
  "schemaVersion": 4,
  "family": "toolbar",
  "role": "toolbar",
  "items": "focusable-children",
  "loop": true,
  "orientations": ["horizontal", "vertical"],
  "members": {
    "toolbar": {
      "nativeElement": "div",
      "defaults": {
        "orientation": "horizontal"
      },
      "capabilities": ["orientation"],
      "states": ["default"],
      "parts": ["root"]
    }
  },
  "scenarios": {
    "toolbar": ["playground", "orientations", "keyboard", "composition"]
  }
}
