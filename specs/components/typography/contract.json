{
  "schemaVersion": 5,
  "family": "typography",
  "ui": "typography",
  "catalog": {
    "group": "Data display",
    "summary": "Text and heading with type scale steps."
  },
  "axes": {
    "size": ["xs", "sm", "md", "lg", "xl", "2xl", "3xl"],
    "weight": ["regular", "medium", "semibold"],
    "tone": [
      "inherit",
      "default",
      "muted",
      "accent",
      "info",
      "success",
      "warning",
      "danger",
      "inverse"
    ],
    "align": ["start", "center", "end"],
    "wrap": ["normal", "nowrap", "balance", "pretty"],
    "transform": ["none", "uppercase", "capitalize"],
    "numeric": ["normal", "tabular"],
    "level": ["1", "2", "3", "4", "5", "6"]
  },
  "members": {
    "text": {
      "nativeElement": "span",
      "defaults": {
        "size": "md",
        "weight": "regular",
        "tone": "inherit"
      },
      "capabilities": ["size"],
      "states": ["default"],
      "parts": ["root"]
    },
    "heading": {
      "nativeElement": "h1",
      "defaults": {
        "size": "level",
        "weight": "semibold",
        "tone": "inherit",
        "wrap": "balance"
      },
      "capabilities": ["size"],
      "states": ["default"],
      "parts": ["root"]
    }
  },
  "scenarios": {
    "text": ["playground", "scale", "tone", "truncation", "accessibility"],
    "heading": ["playground", "levels", "hierarchy", "accessibility"]
  }
}
