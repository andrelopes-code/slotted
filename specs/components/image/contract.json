{
  "schemaVersion": 5,
  "family": "image",
  "ui": "image",
  "catalog": {
    "group": "Data display",
    "summary": "Image with loading, error and fit states."
  },
  "composes": ["aspect-ratio"],
  "axes": {
    "layout": ["intrinsic", "fill", "framed"],
    "fit": ["cover", "contain", "fill", "none", "scale-down"],
    "position": ["center", "top", "bottom", "start", "end", "custom"],
    "radius": ["none", "sm", "md", "lg"],
    "placeholder": ["none", "surface", "blur"],
    "status": ["idle", "loading", "loaded", "error"]
  },
  "stateAttributes": {},
  "members": {
    "image": {
      "nativeElement": "div",
      "defaults": {
        "layout": "intrinsic",
        "fit": "cover",
        "position": "center",
        "radius": "none",
        "placeholder": "surface",
        "bordered": false,
        "priority": false,
        "loading": "lazy",
        "decoding": "async"
      },
      "capabilities": ["appearance", "measurement", "status", "content"],
      "states": ["default", "hover", "focus-visible"],
      "parts": ["root", "picture", "image", "placeholder", "fallback"]
    }
  },
  "scenarios": {
    "image": [
      "playground",
      "sizing",
      "ratio",
      "fit",
      "position",
      "appearance",
      "loading",
      "error",
      "sources",
      "status",
      "interactive",
      "in-context",
      "accessibility"
    ]
  }
}
