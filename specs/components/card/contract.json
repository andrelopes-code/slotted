{
  "schemaVersion": 5,
  "family": "card",
  "ui": "card",
  "catalog": {
    "group": "Layout",
    "summary": "Bordered surface that groups related content."
  },
  "axes": {
    "orientation": ["vertical", "horizontal"],
    "fill": ["outline", "elevated", "subtle"],
    "size": ["sm", "md", "lg"]
  },
  "members": {
    "card": {
      "nativeElement": "div",
      "defaults": {
        "orientation": "vertical",
        "fill": "outline",
        "size": "md",
        "selected": false,
        "disabled": false
      },
      "capabilities": ["orientation", "size"],
      "states": ["default", "hover", "active", "focus-visible", "selected", "disabled"],
      "parts": ["root", "media", "header", "actions", "body", "footer", "link", "selection"]
    }
  },
  "stateAttributes": {
    "selected": "data-selected",
    "disabled": "data-disabled"
  },
  "scenarios": {
    "card": ["playground", "anatomy", "appearance", "orientation", "interactive", "composition"]
  }
}
