{
  "schemaVersion": 4,
  "family": "tag",
  "axes": {
    "variant": ["accent", "secondary", "success", "warning", "danger"],
    "fill": ["solid", "outline", "subtle"],
    "size": ["sm", "md"]
  },
  "stateAttributes": {
    "disabled": "data-disabled"
  },
  "members": {
    "tag": {
      "nativeElement": "span",
      "defaults": {
        "variant": "secondary",
        "fill": "solid",
        "size": "md"
      },
      "capabilities": ["appearance"],
      "states": ["default"],
      "parts": ["root"]
    },
    "tagRemove": {
      "nativeElement": "button",
      "defaults": {
        "disabled": false
      },
      "capabilities": ["wiring", "disabled"],
      "states": ["default", "hover", "active", "focus-visible", "disabled"],
      "parts": ["remove"]
    }
  },
  "scenarios": {
    "tag": ["playground", "appearance", "removable", "composition"]
  }
}
