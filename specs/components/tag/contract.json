{
  "schemaVersion": 5,
  "family": "tag",
  "ui": "tag",
  "catalog": {
    "group": "Data display",
    "summary": "Label for a category, removable or selectable."
  },
  "axes": {
    "tone": ["accent", "secondary", "info", "success", "warning", "danger"],
    "variant": ["solid", "soft", "outline", "dashed"],
    "size": ["sm", "md", "lg"],
    "shape": ["pill", "square"],
    "orientation": ["horizontal", "vertical"]
  },
  "messages": ["remove"],
  "stateAttributes": {
    "disabled": "data-disabled",
    "selected": "data-selected"
  },
  "stateModel": {
    "selection": {
      "controlled": "selected",
      "uncontrolled": "defaultSelected",
      "request": "onSelectedChange",
      "reasons": ["pointer", "keyboard"]
    }
  },
  "members": {
    "tag": {
      "nativeElement": "span",
      "defaults": {
        "tone": "secondary",
        "variant": "soft",
        "size": "md",
        "shape": "pill",
        "orientation": "horizontal",
        "disabled": false
      },
      "capabilities": [
        "appearance",
        "size",
        "shape",
        "content",
        "disabled",
        "removable",
        "orientation"
      ],
      "states": ["default", "hover", "active", "focus-visible", "disabled"],
      "parts": ["root", "body", "start", "label", "end", "remove", "group"]
    },
    "tagButton": {
      "nativeElement": "span",
      "defaults": {
        "tone": "secondary",
        "variant": "soft",
        "size": "md",
        "shape": "pill",
        "disabled": false
      },
      "capabilities": ["appearance", "size", "shape", "content", "disabled", "removable"],
      "states": ["default", "hover", "active", "focus-visible", "disabled"],
      "parts": ["root", "body", "start", "label", "end", "remove"]
    },
    "tagLink": {
      "nativeElement": "span",
      "defaults": {
        "tone": "secondary",
        "variant": "soft",
        "size": "md",
        "shape": "pill",
        "disabled": false
      },
      "capabilities": ["appearance", "size", "shape", "content", "disabled", "removable"],
      "states": ["default", "hover", "active", "focus-visible", "disabled"],
      "parts": ["root", "body", "start", "label", "end", "remove"]
    },
    "tagToggle": {
      "nativeElement": "span",
      "defaults": {
        "tone": "secondary",
        "variant": "soft",
        "size": "md",
        "shape": "pill",
        "disabled": false,
        "selected": false
      },
      "capabilities": [
        "appearance",
        "size",
        "shape",
        "content",
        "disabled",
        "removable",
        "selection"
      ],
      "states": ["default", "hover", "active", "focus-visible", "selected", "disabled"],
      "parts": ["root", "body", "indicator", "start", "label", "end", "remove"]
    }
  },
  "scenarios": {
    "overview": ["members", "appearance", "sizes", "group", "composition", "accessibility"],
    "tag": ["playground", "removal", "content"],
    "tagButton": ["playground", "states"],
    "tagLink": ["playground", "states"],
    "tagToggle": ["playground", "selection"]
  }
}
