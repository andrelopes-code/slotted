{
  "schemaVersion": 4,
  "family": "collapsible",
  "openAttribute": "open",
  "members": {
    "collapsible": {
      "nativeElement": "details",
      "defaults": {
        "open": false
      },
      "capabilities": ["open"],
      "states": ["default"],
      "parts": ["root"]
    },
    "collapsibleTrigger": {
      "nativeElement": "summary",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default", "hover", "active", "focus-visible"],
      "parts": ["trigger"]
    },
    "collapsibleContent": {
      "nativeElement": "div",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["content"]
    }
  },
  "scenarios": {
    "collapsible": ["playground", "open", "composition", "accessibility"]
  }
}
