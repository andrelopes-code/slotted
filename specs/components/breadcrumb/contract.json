{
  "schemaVersion": 4,
  "family": "breadcrumb",
  "separator": "stylesheet",
  "stateAttributes": {
    "current": "data-current"
  },
  "members": {
    "breadcrumb": {
      "nativeElement": "nav",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["root"]
    },
    "breadcrumbList": {
      "nativeElement": "ol",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["list"]
    },
    "breadcrumbItem": {
      "nativeElement": "li",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["item"]
    },
    "breadcrumbLink": {
      "nativeElement": "a",
      "defaults": {
        "current": false
      },
      "capabilities": ["wiring", "current"],
      "states": ["default", "hover", "focus-visible", "current"],
      "parts": ["link"]
    }
  },
  "scenarios": {
    "breadcrumb": ["playground", "current", "composition", "accessibility"]
  }
}
