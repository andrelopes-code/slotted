{
  "schemaVersion": 4,
  "family": "input",
  "stateSource": "field",
  "mirrorsState": true,
  "requiredAttribute": "aria-required",
  "disabledAttribute": "disabled",
  "axes": {
    "size": ["sm", "md", "lg"]
  },
  "stateAttributes": {
    "disabled": "data-disabled",
    "invalid": "data-invalid",
    "required": "data-required",
    "readonly": "data-readonly"
  },
  "members": {
    "input": {
      "nativeElement": "input",
      "defaults": {
        "size": "md"
      },
      "capabilities": ["size", "disabled", "invalid", "required", "readOnly"],
      "states": [
        "default",
        "hover",
        "focus-visible",
        "disabled",
        "invalid",
        "required",
        "readonly"
      ],
      "parts": ["root"]
    }
  },
  "scenarios": {
    "input": ["playground", "sizes", "states", "field"]
  }
}
