{
  "schemaVersion": 5,
  "family": "sparkline",
  "ui": "sparkline",
  "catalog": {
    "group": "Data display",
    "summary": "Tiny inline trend chart."
  },
  "axes": {
    "type": ["line", "bar"],
    "size": ["sm", "md", "lg"],
    "curve": ["linear", "monotone"],
    "tone": ["neutral", "accent", "secondary", "info", "success", "warning", "danger"],
    "series": ["1", "2", "3", "4", "5", "6", "7", "8"]
  },
  "nominalSize": {
    "sm": { "width": 96, "height": 20 },
    "md": { "width": 96, "height": 32 },
    "lg": { "width": 96, "height": 48 }
  },
  "members": {
    "sparkline": {
      "nativeElement": "span",
      "defaults": {
        "type": "line",
        "size": "md",
        "curve": "linear",
        "area": false,
        "marker": true
      },
      "capabilities": ["appearance", "size", "measurement", "content"],
      "states": ["default"],
      "parts": ["root", "plot", "area", "line", "bar", "reference", "ring", "marker"]
    }
  },
  "messages": ["down", "flat", "noData", "up"],
  "stateAttributes": {},
  "motion": "the marks ease to a new data, written as data-animate on the root for that render and only under prefers-reduced-motion: no-preference; a change of the measured box redraws at once. The root keeps the nominal width as its minimum (--slotted-sparkline-min-inline-size, 6rem) in a box sized by its content",
  "scenarios": {
    "sparkline": [
      "playground",
      "types",
      "sizes",
      "tone",
      "series",
      "reference",
      "gaps",
      "extremes",
      "in-table",
      "accessibility"
    ]
  }
}
