{
  "schemaVersion": 5,
  "family": "textarea",
  "ui": "textarea",
  "catalog": {
    "group": "Forms",
    "summary": "Multi-line text input."
  },
  "controlPart": "root",
  "stateSource": "field",
  "mirrorsState": true,
  "requiredAttribute": "aria-required",
  "disabledAttribute": "disabled",
  "wiring": {
    "id": "always",
    "aria-describedby": "merged",
    "aria-invalid": "invalid",
    "aria-required": "required",
    "disabled": "disabled",
    "readonly": "readOnly"
  },
  "autoSizeMechanism": "field-sizing",
  "autoSizeFloor": "rows",
  "autoSizeCeiling": "maxRows",
  "resizeWithdrawnBy": "autoSize",
  "counter": {
    "unit": "utf-16",
    "placedBy": "field",
    "limitFrom": "maxLength"
  },
  "keyboard": [],
  "submitsOnEnter": false,
  "axes": {
    "size": ["sm", "md", "lg"],
    "variant": ["outline", "subtle", "plain"],
    "resize": ["block", "none", "both"]
  },
  "resolution": {
    "size": ["prop", "field", "defaults", "md"],
    "variant": ["prop", "defaults", "outline"]
  },
  "provides": {
    "textareaDefaults": ["size", "variant", "mono", "resize"]
  },
  "stateAttributes": {
    "disabled": "data-disabled",
    "invalid": "data-invalid",
    "readonly": "data-readonly"
  },
  "stateModel": {
    "value": {
      "controlled": "value",
      "uncontrolled": "defaultValue",
      "request": "onValueChange",
      "reasons": ["keyboard"]
    }
  },
  "members": {
    "textarea": {
      "nativeElement": "textarea",
      "defaults": {
        "size": "md",
        "variant": "outline",
        "mono": false,
        "resize": "block",
        "autoSize": false,
        "rows": 3,
        "maxRows": 12,
        "showCount": false
      },
      "capabilities": [
        "value",
        "appearance",
        "size",
        "disabled",
        "invalid",
        "required",
        "readOnly",
        "wiring"
      ],
      "states": ["default", "hover", "focus-visible", "disabled", "invalid", "readonly"],
      "parts": ["root"]
    }
  },
  "scenarios": {
    "textarea": [
      "playground",
      "sizes",
      "variants",
      "auto-size",
      "resize",
      "states",
      "count",
      "content",
      "composition",
      "keyboard"
    ]
  }
}
