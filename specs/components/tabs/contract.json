{
  "schemaVersion": 4,
  "family": "tabs",
  "orientations": ["horizontal", "vertical"],
  "activation": ["automatic", "manual"],
  "stateAttributes": {
    "selected": "data-selected",
    "disabled": "data-disabled"
  },
  "members": {
    "tabs": {
      "nativeElement": "div",
      "defaults": {
        "activation": "automatic",
        "orientation": "horizontal"
      },
      "capabilities": ["orientation", "activation", "selection"],
      "states": ["default"],
      "parts": ["root"]
    },
    "tabList": {
      "nativeElement": "div",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["list"]
    },
    "tab": {
      "nativeElement": "button",
      "defaults": {
        "disabled": false
      },
      "capabilities": ["wiring", "disabled"],
      "states": ["default", "hover", "active", "focus-visible", "selected", "disabled"],
      "parts": ["tab"]
    },
    "tabPanel": {
      "nativeElement": "div",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["panel"]
    }
  },
  "scenarios": {
    "tabs": ["playground", "orientations", "activation", "states", "composition", "accessibility"]
  }
}
