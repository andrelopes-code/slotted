{
  "schemaVersion": 4,
  "family": "file-upload",
  "control": "fileUploadInput",
  "labelledBy": "fileUploadDropzone",
  "inputType": "file",
  "hidden": "visually",
  "focusRing": "fileUploadDropzone",
  "liveRegion": "fileUploadList",
  "rejectionReasons": ["type", "size", "multiple"],
  "stateAttributes": {
    "disabled": "data-disabled",
    "dragging": "data-dragging"
  },
  "members": {
    "fileUpload": {
      "nativeElement": "div",
      "defaults": {
        "multiple": false
      },
      "capabilities": ["files", "disabled"],
      "states": ["default", "disabled"],
      "parts": ["root"]
    },
    "fileUploadDropzone": {
      "nativeElement": "label",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default", "hover", "focus-visible", "disabled", "dragging"],
      "parts": ["dropzone"]
    },
    "fileUploadInput": {
      "nativeElement": "input",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default", "disabled"],
      "parts": ["input"]
    },
    "fileUploadList": {
      "nativeElement": "ul",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["list"]
    },
    "fileUploadItem": {
      "nativeElement": "li",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["item"]
    }
  },
  "scenarios": {
    "fileUpload": ["playground", "validation", "progress", "accessibility"]
  }
}
