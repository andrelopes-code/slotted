{
  "schemaVersion": 5,
  "family": "currency-field",
  "ui": "currency-field",
  "catalog": {
    "group": "Forms",
    "summary": "Number input for amounts in a currency."
  },
  "controlPart": "input",
  "controlRole": "spinbutton",
  "rootRole": null,
  "inputType": "text",
  "hiddenValueInput": true,
  "valueType": "number | null",
  "valueUnit": "major",
  "core": ["@slotted/core/currency", "@slotted/core/number"],
  "stateSource": "field",
  "mirrorsState": true,
  "requiredAttribute": "aria-required",
  "disabledAttribute": "disabled",
  "wiring": {
    "id": "always",
    "aria-describedby": "merged",
    "aria-invalid": "invalid",
    "aria-required": "required",
    "disabled": "disabled",
    "readonly": "readOnly"
  },
  "ariaValue": ["aria-valuenow", "aria-valuemin", "aria-valuemax", "aria-valuetext"],
  "keyboard": [
    {
      "key": "ArrowUp",
      "effect": "step",
      "by": "step"
    },
    {
      "key": "ArrowDown",
      "effect": "step",
      "by": "step"
    },
    {
      "key": "Shift+ArrowUp",
      "effect": "step",
      "by": "largeStep"
    },
    {
      "key": "Shift+ArrowDown",
      "effect": "step",
      "by": "largeStep"
    },
    {
      "key": "Alt+ArrowUp",
      "effect": "step",
      "by": "smallStep"
    },
    {
      "key": "Alt+ArrowDown",
      "effect": "step",
      "by": "smallStep"
    },
    {
      "key": "PageUp",
      "effect": "step",
      "by": "largeStep"
    },
    {
      "key": "PageDown",
      "effect": "step",
      "by": "largeStep"
    },
    {
      "key": "Home",
      "effect": "min"
    },
    {
      "key": "End",
      "effect": "max"
    },
    {
      "key": "Enter",
      "effect": "commit"
    },
    {
      "key": "-",
      "effect": "sign",
      "sign": "negative"
    },
    {
      "key": "+",
      "effect": "sign",
      "sign": "positive"
    }
  ],
  "escapeBound": false,
  "enterSubmits": true,
  "stepperTabIndex": -1,
  "stepperNames": ["increment", "decrement"],
  "stepperDisabledAtBound": true,
  "parseOn": "input",
  "commitOn": ["blur", "enter", "step", "wheel", "scrub"],
  "entryModel": {
    "cents": {
      "digitsAre": "the value",
      "shiftBy": "minorUnits",
      "writesTextOn": "input",
      "caret": "after the last digit",
      "caretIgnored": true,
      "separatorTyped": false,
      "signKeys": ["-", "+"],
      "pasteParsed": true,
      "maxDigits": 15,
      "emptyValue": "allowEmpty"
    },
    "natural": {
      "digitsAre": "text until a commit",
      "shiftBy": null,
      "writesTextOn": "commit",
      "caret": "the reader's",
      "separatorTyped": true,
      "signKeys": [],
      "pasteParsed": true,
      "maxDigits": null,
      "emptyValue": "allowEmpty"
    }
  },
  "range": {
    "min": "min",
    "max": "max",
    "step": "step",
    "largeStep": "largeStep",
    "smallStep": "smallStep",
    "stepFrom": "stepFrom"
  },
  "stepDefaults": {
    "largeStep": "step * 10",
    "smallStep": "step / 10",
    "stepFrom": "min, or 0"
  },
  "scrub": {
    "part": "scrub",
    "placedIn": ["start", "end"],
    "gesture": "horizontal drag with pointer capture",
    "perStep": "sensitivity pixels, default 2",
    "modifiers": {
      "Shift": "largeStep",
      "Alt": "smallStep"
    },
    "direction": "towards the inline end steps up; rtl mirrors it",
    "reason": "pointer",
    "focus": "a press focuses the input",
    "keyboard": "none: the input's arrow keys are the equivalent"
  },
  "format": {
    "style": "currency",
    "currency": "ISO 4217",
    "options": "Intl.NumberFormatOptions",
    "locale": "BCP 47",
    "parserFrom": "formatToParts",
    "fractionDigitsFrom": "the currency's minor units",
    "accountingNegative": "( )"
  },
  "inputMode": {
    "cents": "numeric",
    "negative": "text",
    "fractional": "decimal",
    "integer": "numeric"
  },
  "autocompleteTokens": ["transaction-amount", "transaction-currency"],
  "axes": {
    "size": ["sm", "md", "lg"],
    "variant": ["outline", "subtle", "plain"],
    "entry": ["cents", "natural"],
    "align": ["end", "start"],
    "stepper": ["none", "stacked", "split"],
    "clamp": ["blur", "strict", "none"],
    "currencyDisplay": ["symbol", "narrowSymbol", "code", "name", "none"],
    "formatOn": ["change", "commit"],
    "appearance": ["control", "display"]
  },
  "resolution": {
    "size": ["prop", "field", "defaults", "md"],
    "variant": ["prop", "defaults", "outline"],
    "entry": ["prop", "defaults", "cents"],
    "align": ["prop", "defaults", "end"],
    "stepper": ["prop", "defaults", "none"],
    "clamp": ["prop", "defaults", "blur"],
    "formatOn": ["prop", "defaults", "change"],
    "unit": ["prop", "defaults", "major"],
    "currency": ["prop", "defaults"],
    "currencyDisplay": ["prop", "defaults", "symbol"],
    "locale": ["prop", "slotted", "en-US"],
    "appearance": ["prop", "control"]
  },
  "provides": {
    "currencyFieldDefaults": [
      "align",
      "clamp",
      "currency",
      "currencyDisplay",
      "entry",
      "formatOn",
      "size",
      "stepper",
      "unit",
      "variant"
    ]
  },
  "messages": ["decrement", "increment"],
  "imperative": ["increment", "decrement"],
  "stateAttributes": {
    "disabled": "data-disabled",
    "invalid": "data-invalid",
    "readonly": "data-readonly"
  },
  "dataAttributes": {
    "data-scrubbing": "a scrub part is being dragged, on the root and on the part"
  },
  "stateModel": {
    "value": {
      "controlled": "value",
      "uncontrolled": "defaultValue",
      "request": "onValueChange",
      "reasons": ["keyboard", "pointer", "blur", "programmatic"],
      "carries": ["value", "previous", "minorUnits", "reason", "event"]
    }
  },
  "literals": {
    "--slotted-currency-field-stepper-size": "The stepper column is square and sized from the control's own glyph scale plus its gap, which is arithmetic over tokens rather than a literal; the floor under it is --slotted-target-min, which the theme owns."
  },
  "members": {
    "currencyField": {
      "nativeElement": "input",
      "defaults": {
        "size": "md",
        "variant": "outline",
        "entry": "cents",
        "align": "end",
        "stepper": "none",
        "step": 1,
        "clamp": "blur",
        "formatOn": "change",
        "currencyDisplay": "symbol",
        "wheel": false,
        "allowEmpty": false,
        "appearance": "control"
      },
      "capabilities": [
        "value",
        "appearance",
        "size",
        "content",
        "disabled",
        "invalid",
        "required",
        "readOnly",
        "wiring"
      ],
      "states": ["default", "hover", "active", "focus-visible", "disabled", "invalid", "readonly"],
      "parts": [
        "root",
        "symbol",
        "input",
        "start",
        "end",
        "scrub",
        "stepper",
        "decrement",
        "increment"
      ]
    }
  },
  "scenarios": {
    "currencyField": [
      "playground",
      "entry",
      "currency",
      "locale",
      "sizes",
      "variants",
      "alignment",
      "range",
      "stepper",
      "adornments",
      "scrub",
      "states",
      "content",
      "composition",
      "keyboard"
    ]
  },
  "display": {
    "size": "appearance display: the headline amount of an entry sheet, at the 4xl step, medium weight, the tighter tracking, tabular figures. It sets its own type step and draws a rule instead of a box, so size and variant do not apply to it; they stay the vocabulary the sibling controls share.",
    "symbol": "At the display step the currency mark is drawn apart from the digits, in the symbol part on the side the locale writes it, muted at the xl step; the input holds the amount alone and its aria-valuetext carries the mark. Under currencyDisplay none there is no symbol part.",
    "width": "Where the platform supports field-sizing the control is as wide as the amount; elsewhere it takes the line and align places the amount.",
    "underline": "No box: a rule under the amount that takes the text color and doubles on focus, and takes the danger color when invalid.",
    "contract": "Entry, value, onValueChange and the request with minorUnits are the same at every size, and the field around it names it and states invalid."
  }
}
