{
  "schemaVersion": 5,
  "family": "badge",
  "ui": "badge",
  "catalog": {
    "group": "Data display",
    "summary": "Short label or count attached to an element."
  },
  "axes": {
    "tone": ["accent", "secondary", "info", "success", "warning", "danger"],
    "variant": ["solid", "soft", "outline"],
    "size": ["sm", "md", "lg"],
    "shape": ["pill", "square", "dot"],
    "live": ["off", "polite", "assertive"],
    "placement": ["top-end", "top-start", "bottom-end", "bottom-start"],
    "overlap": ["rectangle", "circle"]
  },
  "members": {
    "badge": {
      "nativeElement": "span",
      "defaults": {
        "tone": "secondary",
        "variant": "soft",
        "size": "md",
        "shape": "pill",
        "live": "off",
        "placement": "top-end",
        "overlap": "rectangle",
        "offset": "{ x: 0, y: 0 }",
        "max": 99,
        "showZero": false
      },
      "capabilities": ["appearance", "size", "shape", "content", "live", "placement"],
      "states": ["default", "focus-visible"],
      "parts": ["root", "start", "label", "end", "anchor"]
    }
  },
  "scenarios": {
    "badge": [
      "playground",
      "appearance",
      "sizes",
      "shapes",
      "count",
      "anchored",
      "composition",
      "accessibility"
    ]
  }
}
