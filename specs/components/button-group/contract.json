{
  "schemaVersion": 5,
  "family": "button-group",
  "ui": "button-group",
  "catalog": {
    "group": "Actions",
    "summary": "Buttons joined into one control."
  },
  "role": "group",
  "rovingFocus": false,
  "rovingFocusOwner": "toolbar",
  "alignAuto": {
    "horizontal": "stretch",
    "vertical": "stretch"
  },
  "seam": {
    "ui": "button",
    "variant": "solid",
    "colorRole": "solid-active",
    "toneAttribute": "data-tone"
  },
  "provides": {
    "buttonDefaults": ["tone", "variant", "size"]
  },
  "axes": {
    "orientation": ["horizontal", "vertical"],
    "align": ["auto", "start", "center", "end", "stretch"],
    "justify": ["start", "center", "end", "between"]
  },
  "members": {
    "buttonGroup": {
      "nativeElement": "div",
      "defaults": {
        "orientation": "horizontal",
        "align": "auto",
        "fullWidth": false,
        "decorative": false
      },
      "capabilities": ["arrangement", "orientation", "appearance", "fullWidth", "decorative"],
      "states": ["default"],
      "parts": ["root", "separator"]
    }
  },
  "scenarios": {
    "buttonGroup": [
      "playground",
      "shape",
      "orientation",
      "separator",
      "width",
      "composition",
      "accessibility"
    ]
  },
  "frameOwner": "button-group"
}
