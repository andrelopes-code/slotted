{
  "schemaVersion": 5,
  "family": "link",
  "ui": "link",
  "catalog": {
    "group": "Navigation",
    "summary": "Text link to another page or resource."
  },
  "axes": {
    "size": ["xs", "sm", "md"],
    "underline": ["always", "hover", "none"],
    "variant": ["accent", "neutral", "inverse"]
  },
  "stateAttributes": {
    "disabled": "data-disabled"
  },
  "messages": ["externalHint"],
  "members": {
    "link": {
      "nativeElement": "a",
      "defaults": {
        "underline": "always",
        "variant": "accent",
        "visited": false,
        "external": false,
        "disabled": false
      },
      "capabilities": ["appearance", "underline", "external", "disabled"],
      "states": ["default", "hover", "active", "focus-visible", "disabled"],
      "parts": ["root", "external-icon", "external-hint"]
    }
  },
  "scenarios": {
    "link": [
      "playground",
      "underline",
      "variants",
      "external",
      "states",
      "current",
      "content",
      "composition",
      "accessibility"
    ]
  }
}
