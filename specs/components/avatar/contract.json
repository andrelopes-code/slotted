{
  "schemaVersion": 4,
  "family": "avatar",
  "axes": {
    "size": ["sm", "md", "lg"]
  },
  "stateAttributes": {
    "loaded": "data-loaded"
  },
  "members": {
    "avatar": {
      "nativeElement": "span",
      "defaults": {
        "size": "md"
      },
      "capabilities": ["size"],
      "states": ["default", "loaded"],
      "parts": ["root"]
    },
    "avatarImage": {
      "nativeElement": "img",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["image"]
    },
    "avatarFallback": {
      "nativeElement": "span",
      "defaults": {},
      "capabilities": ["wiring"],
      "states": ["default"],
      "parts": ["fallback"]
    }
  },
  "scenarios": {
    "avatar": ["playground", "sizes", "fallback", "composition"]
  }
}
