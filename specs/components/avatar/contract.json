{
  "schemaVersion": 5,
  "family": "avatar",
  "ui": "avatar",
  "catalog": {
    "group": "Data display",
    "summary": "Image or initials that stand for a person."
  },
  "fallbackOrder": ["image", "initials", "glyph"],
  "autoTonePalette": ["accent", "secondary", "success", "warning", "danger"],
  "axes": {
    "size": ["xs", "sm", "md", "lg", "xl"],
    "shape": ["circle", "square"],
    "tone": ["auto", "accent", "secondary", "info", "success", "warning", "danger"],
    "variant": ["soft", "solid"],
    "surface": ["tone", "none", "plate"],
    "status": ["idle", "loading", "loaded", "error"]
  },
  "stateAttributes": {
    "disabled": "data-disabled"
  },
  "members": {
    "avatar": {
      "nativeElement": "span",
      "defaults": {
        "size": "md",
        "shape": "circle",
        "tone": "auto",
        "variant": "soft",
        "surface": "tone",
        "decorative": false,
        "disabled": false
      },
      "capabilities": ["appearance", "size", "shape", "status", "disabled", "decorative"],
      "states": ["default", "hover", "focus-visible", "disabled"],
      "parts": ["root", "image", "fallback"]
    }
  },
  "scenarios": {
    "avatar": [
      "playground",
      "sizes",
      "fallback",
      "identity",
      "shapes",
      "status",
      "interactive",
      "accessibility"
    ]
  }
}
