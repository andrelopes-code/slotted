{
  "schemaVersion": 5,
  "family": "stat-card",
  "ui": "stat-card",
  "catalog": {
    "group": "Data display",
    "summary": "Key figure with label, change and trend."
  },
  "axes": {
    "size": ["sm", "md", "lg"],
    "fill": ["outline", "elevated", "subtle", "plain"],
    "layout": ["inline", "stacked"],
    "status": ["ready", "empty", "error"],
    "goodWhen": ["up", "down", "none"],
    "tone": ["neutral", "accent", "secondary", "info", "success", "warning", "danger"],
    "trend": ["up", "down", "flat"],
    "attention": ["warning", "danger"]
  },
  "members": {
    "stat-card": {
      "nativeElement": "div",
      "defaults": {
        "size": "md",
        "fill": "outline",
        "layout": "inline",
        "status": "ready",
        "goodWhen": "up",
        "loading": false
      },
      "capabilities": ["appearance", "size", "status", "loading", "content"],
      "states": ["default", "loading"],
      "parts": [
        "root",
        "body",
        "header",
        "label",
        "status",
        "action",
        "figure",
        "value",
        "unit",
        "delta",
        "indicator",
        "comparison",
        "period",
        "trend",
        "message"
      ]
    }
  },
  "messages": ["down", "empty", "flat", "up"],
  "stateAttributes": {
    "loading": "data-loading"
  },
  "scenarios": {
    "stat-card": [
      "playground",
      "anatomy",
      "good-when",
      "sizes",
      "fill",
      "layout",
      "loading",
      "status",
      "row",
      "content",
      "accessibility"
    ]
  }
}
