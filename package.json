{
  "name": "slotted",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --build tsconfig.base.json --pretty false",
    "test:contracts": "node --test specs/*.test.mjs specs/components/*/*.test.mjs",
    "test:layers": "node --test scripts/verify-layers.test.mjs && node scripts/verify-layers.mjs",
    "test:docs": "node --test scripts/verify-docs-snippets.test.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:contracts && pnpm test:layers && pnpm test:docs",
    "check:affected": "pnpm check && turbo run verify --affected",
    "check:full": "pnpm check && turbo run verify"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/compiler-cli": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "ng-packagr": "22.1.1",
    "prettier": "3.9.6",
    "rxjs": "7.8.2",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
